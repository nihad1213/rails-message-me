<div class="ui container" style="margin-top: 2em;">
  <%= turbo_stream_from "chatroom" %>

  <div class="ui segment" id="messages" style="height: 60vh; overflow-y: auto;">
    <%= render @messages %>
  </div>

  <%= form_with model: @message, url: messages_path, class: "ui form",
                data: { turbo_stream: true, action: "turbo:submit-end->this.reset()" } do |f| %>
    <div class="ui fluid action input">
      <%= f.text_field :body, placeholder: "Type a message...", autocomplete: "off" %>
      <%= f.submit "Send", class: "ui primary button" %>
    </div>
  <% end %>
</div>