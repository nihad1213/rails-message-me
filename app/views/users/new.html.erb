<div class="ui container" style="margin-top: 2em; max-width: 450px !important;">
  <h2 class="ui header">Sign Up</h2>

  <%= form_with model: @user, class: "ui form" do |f| %>
    <% if @user.errors.any? %>
      <div class="ui negative message">
        <ul class="list">
          <% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="field"><%= f.label :username %><%= f.text_field :username %></div>
    <div class="field"><%= f.label :email %><%= f.email_field :email %></div>
    <div class="field"><%= f.label :password %><%= f.password_field :password %></div>
    <div class="field"><%= f.label :password_confirmation %><%= f.password_field :password_confirmation %></div>
    <%= f.submit "Sign Up", class: "ui primary button" %>
  <% end %>
</div>